# Copy to .env. Never share .env.

# Brains. provider:model. MODEL sets both, MODEL_TRIAGE and MODEL_DRAFT override per job.
#   anthropic:claude-sonnet-5   needs ANTHROPIC_API_KEY (platform.claude.com) and credits
#   ollama:gemma3:4b            free, local, Ollama must be running
#   fake:rules                  no model, keyword rules + runbook text. Always works. Demo safety net.
MODEL_TRIAGE=ollama:gemma3:4b
MODEL_DRAFT=ollama:gemma3:4b
# MODEL=ollama:gemma3:4b       # shortcut: sets both when the two above are empty
# OLLAMA_NUM_CTX=8192          # context window for Ollama models
ANTHROPIC_API_KEY=
ANTHROPIC_WORKSPACE_ID=

# Policy
AUTO_REPLY=on               # L1, safe category, confident -> reply with no click. off = every reply waits for a person
AUTO_ESCALATE=on            # L2/L3, confident -> hand over with a note and no click
AUTO_MIN_CONFIDENCE=0.8

# Tickets
TICKET_SOURCE=local         # local (data/tickets.json + dashboard) or freshservice
FRESHSERVICE_DOMAIN=
FRESHSERVICE_API_KEY=
FRESHSERVICE_L2_GROUP_ID=
FRESHSERVICE_L3_GROUP_ID=
FRESHSERVICE_TAG=ticketdesk

PORT=8000
